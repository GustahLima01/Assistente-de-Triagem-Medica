{
  "name": "assistente-de-triagem-medica",
  "version": "1.0.0",
  "description": "API REST para assistente de triagem médica com persistência em memória.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit && npm run test:functional",
    "test:unit": "mocha \"tests/{services,utils}/**/*.test.js\"",
    "test:functional": "mocha --require tests/helpers/testSetup.js \"tests/{auth,users,patients,doctors,symptoms,triages,appointments}/**/*.test.js\"",
    "test:functional:report": "mocha --require tests/helpers/testSetup.js \"tests/{auth,users,patients,doctors,symptoms,triages,appointments}/**/*.test.js\" --reporter mochawesome --reporter-options reportDir=reports/api-tests,reportFilename=index,quiet=true,html=true,json=true",
    "test:performance": "node tests/performance/run-performance.js",
    "test:performance:auth-login": "k6 run tests/performance/auth-login.k6.js",
    "test:performance:triage-specialty-consult": "k6 run tests/performance/triage-specialty-consult.k6.js",
    "test:performance:appointments-create": "k6 run tests/performance/appointments-create.k6.js",
    "test:performance:reception-journey": "k6 run tests/performance/reception-journey.k6.js"
  },
  "keywords": [
    "express",
    "swagger",
    "jwt",
    "triagem-medica"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "proxyquire": "^2.1.3",
    "sinon": "^21.1.2",
    "supertest": "^7.2.2"
  }
}
