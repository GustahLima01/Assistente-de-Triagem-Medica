{
  "openapi": "3.0.3",
  "info": {
    "title": "Assistente de Triagem Medica API",
    "version": "1.0.0",
    "description": "API REST para triagem medica com Express, JWT e persistencia em memoria."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor local"
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "Patients" },
    { "name": "Doctors" },
    { "name": "Symptoms" },
    { "name": "Triages" },
    { "name": "Appointments" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Campos obrigatorios ausentes." },
              "details": {
                "nullable": true,
                "oneOf": [
                  { "type": "object", "additionalProperties": true },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "API operacional." },
          "data": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "ok" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "ClinicUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "name": { "type": "string", "example": "Maria Silva" },
          "email": { "type": "string", "format": "email", "example": "maria@clinica.local" },
          "role": { "type": "string", "enum": ["ADMIN", "RECEPTIONIST", "DOCTOR"] },
          "active": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "name": { "type": "string", "example": "Joao da Costa" },
          "document": { "type": "string", "example": "12345678900" },
          "birthDate": { "type": "string", "format": "date", "example": "1990-05-10" },
          "phone": { "type": "string", "example": "+5511999999999" },
          "email": { "type": "string", "nullable": true, "example": "joao@email.com" },
          "notes": { "type": "string", "nullable": true, "example": "Paciente alergico a dipirona." },
          "active": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Doctor": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "name": { "type": "string", "example": "Dra. Ana Souza" },
          "crm": { "type": "string", "example": "CRM-SP-123456" },
          "specialty": { "type": "string", "example": "Cardiologia" },
          "phone": { "type": "string", "nullable": true, "example": "+5511988888888" },
          "email": { "type": "string", "nullable": true, "example": "ana@clinica.local" },
          "active": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Symptom": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "name": { "type": "string", "example": "Dor no peito" },
          "description": { "type": "string", "nullable": true, "example": "Dor opressiva no centro do peito." },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "specialty": { "type": "string", "example": "Cardiologia" },
          "active": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Triage": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "patientId": { "type": "string", "example": "1" },
          "symptomIds": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["1", "2"]
          },
          "symptomsSnapshot": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Symptom" }
          },
          "suggestedSpecialty": { "type": "string", "example": "Cardiologia" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "notes": { "type": "string", "nullable": true, "example": "Paciente com dor recorrente ha 2 dias." },
          "createdByUserId": { "type": "string", "example": "1" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SpecialtyConsultResult": {
        "type": "object",
        "properties": {
          "suggestedSpecialty": { "type": "string", "example": "Cardiologia" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "symptomsConsidered": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Symptom" }
          }
        }
      },
      "Appointment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "patientId": { "type": "string", "example": "1" },
          "doctorId": { "type": "string", "example": "1" },
          "triageId": { "type": "string", "nullable": true, "example": "1" },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "example": "SCHEDULED" },
          "notes": { "type": "string", "nullable": true, "example": "Consulta preferencial pela manha." },
          "createdByUserId": { "type": "string", "example": "1" },
          "updatedByUserId": { "type": "string", "nullable": true, "example": "2" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "admin@clinica.local" },
          "password": { "type": "string", "example": "Admin@123" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Login realizado com sucesso." },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
              "user": { "$ref": "#/components/schemas/ClinicUser" }
            }
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["name", "email", "password", "role"],
        "properties": {
          "name": { "type": "string", "example": "Recepcao 1" },
          "email": { "type": "string", "format": "email", "example": "recepcao1@clinica.local" },
          "password": { "type": "string", "example": "Senha@123" },
          "role": { "type": "string", "enum": ["ADMIN", "RECEPTIONIST", "DOCTOR"] },
          "active": { "type": "boolean", "example": true }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "role": { "type": "string", "enum": ["ADMIN", "RECEPTIONIST", "DOCTOR"] },
          "active": { "type": "boolean" }
        }
      },
      "CreatePatientRequest": {
        "type": "object",
        "required": ["name", "document", "birthDate", "phone"],
        "properties": {
          "name": { "type": "string", "example": "Joao da Costa" },
          "document": { "type": "string", "example": "12345678900" },
          "birthDate": { "type": "string", "format": "date", "example": "1990-05-10" },
          "phone": { "type": "string", "example": "+5511999999999" },
          "email": { "type": "string", "format": "email" },
          "notes": { "type": "string" }
        }
      },
      "UpdatePatientRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "document": { "type": "string" },
          "birthDate": { "type": "string", "format": "date" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "notes": { "type": "string" },
          "active": { "type": "boolean" }
        }
      },
      "CreateDoctorRequest": {
        "type": "object",
        "required": ["name", "crm", "specialty"],
        "properties": {
          "name": { "type": "string", "example": "Dra. Ana Souza" },
          "crm": { "type": "string", "example": "CRM-SP-123456" },
          "specialty": { "type": "string", "example": "Cardiologia" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "UpdateDoctorRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "crm": { "type": "string" },
          "specialty": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "active": { "type": "boolean" }
        }
      },
      "CreateSymptomRequest": {
        "type": "object",
        "required": ["name", "severity", "specialty"],
        "properties": {
          "name": { "type": "string", "example": "Dor no peito" },
          "description": { "type": "string", "example": "Dor opressiva no centro do peito." },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "specialty": { "type": "string", "example": "Cardiologia" }
        }
      },
      "UpdateSymptomRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "specialty": { "type": "string" },
          "active": { "type": "boolean" }
        }
      },
      "SpecialtyConsultRequest": {
        "type": "object",
        "required": ["symptomIds"],
        "properties": {
          "symptomIds": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["1", "2"]
          }
        }
      },
      "CreateTriageRequest": {
        "type": "object",
        "required": ["patientId", "symptomIds"],
        "properties": {
          "patientId": { "type": "string", "example": "1" },
          "symptomIds": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["1", "2"]
          },
          "notes": { "type": "string", "example": "Paciente relata tontura e suor frio." }
        }
      },
      "CreateAppointmentRequest": {
        "type": "object",
        "required": ["patientId", "doctorId", "scheduledAt"],
        "properties": {
          "patientId": { "type": "string", "example": "1" },
          "doctorId": { "type": "string", "example": "1" },
          "triageId": { "type": "string", "example": "1" },
          "scheduledAt": { "type": "string", "format": "date-time", "example": "2026-04-23T10:00:00.000Z" },
          "notes": { "type": "string", "example": "Paciente prefere horario da manha." }
        }
      },
      "UpdateAppointmentRequest": {
        "type": "object",
        "example": {
          "scheduledAt": "2026-06-12T15:00:00.000Z",
          "notes": "Paciente solicitou reagendamento para o periodo da tarde."
        },
        "properties": {
          "doctorId": {
            "type": "string",
            "description": "Informe apenas se desejar trocar o medico. Quando houver triageId no agendamento, o medico deve ter a mesma especialidade sugerida pela triagem."
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-12T15:00:00.000Z",
            "description": "Novo horario da consulta em formato ISO 8601."
          },
          "notes": {
            "type": "string",
            "example": "Paciente solicitou reagendamento para o periodo da tarde.",
            "description": "Observacoes da consulta."
          }
        }
      },
      "ClinicUserResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Usuario criado com sucesso." },
          "data": { "$ref": "#/components/schemas/ClinicUser" }
        }
      },
      "ClinicUserListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": null },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ClinicUser" }
          }
        }
      },
      "PatientResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Paciente criado com sucesso." },
          "data": { "$ref": "#/components/schemas/Patient" }
        }
      },
      "PatientListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": null },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Patient" }
          }
        }
      },
      "DoctorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Medico criado com sucesso." },
          "data": { "$ref": "#/components/schemas/Doctor" }
        }
      },
      "DoctorListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": null },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Doctor" }
          }
        }
      },
      "SymptomResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Sintoma criado com sucesso." },
          "data": { "$ref": "#/components/schemas/Symptom" }
        }
      },
      "SymptomListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": null },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Symptom" }
          }
        }
      },
      "TriageResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Triagem registrada com sucesso." },
          "data": { "$ref": "#/components/schemas/Triage" }
        }
      },
      "TriageListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": null },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Triage" }
          }
        }
      },
      "SpecialtyConsultResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Especialidade sugerida com sucesso." },
          "data": { "$ref": "#/components/schemas/SpecialtyConsultResult" }
        }
      },
      "AppointmentResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": "Consulta agendada com sucesso." },
          "data": { "$ref": "#/components/schemas/Appointment" }
        }
      },
      "AppointmentListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "nullable": true, "example": null },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Appointment" }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisicao invalida",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "Unauthorized": {
        "description": "Nao autenticado",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "Forbidden": {
        "description": "Acesso negado",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "NotFound": {
        "description": "Recurso nao encontrado",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "Conflict": {
        "description": "Conflito de negocio",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "InternalError": {
        "description": "Erro interno",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Verifica a saude da API",
        "responses": {
          "200": {
            "description": "API operacional",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Realiza login de usuario da clinica",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Lista usuarios da clinica",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuarios listados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClinicUserListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Cria usuario da clinica",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario criado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClinicUserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Users"],
        "summary": "Busca usuario por id",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClinicUserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Atualiza usuario da clinica",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario atualizado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClinicUserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Inativa usuario da clinica",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuario inativado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClinicUserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/patients": {
      "get": {
        "tags": ["Patients"],
        "summary": "Lista pacientes",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": { "type": "string" },
